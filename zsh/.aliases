# ====================================
# Seif's Terminal Aliases
# ====================================

# --------- Dev Tools ---------
alias ddd="rm -rf ~/Library/Developer/Xcode/DerivedData"
alias fastlane='mise exec ruby@ios -- fastlane'
alias pod='mise exec ruby@ios -- pod'

# --------- eza (pretty ls replacement) ---------
alias ls="eza --icons --group-directories-first --color=always"
alias ll="eza -l --icons --group-directories-first --color=always"
alias la="eza -la --icons --group-directories-first --color=always"
alias lt="eza -T --icons --group-directories-first --color=always"

# --------- clipboard ---------
alias -g C='| pbcopy'

# --------- wget ---------
alias wget='wget --hsts-file=$HOME/.wget-hsts'

# --------- bat / cat improvements ---------
alias cat='bat --style=numbers,changes --paging=auto'       # Pretty file viewing
alias catn='bat --style=numbers --paging=always'            # Forced line numbers view
alias catp='bat --style=plain --paging=never'               # Clean for copy/paste
alias batp='bat --paging=always --decorations=always'       # Full themed bat preview

# --------- git ---------
alias g="git"
alias gst="git status -sb"
alias ga="git add"
alias gaa="git add --all"
alias gc="git commit"
alias gcm="git commit -m"
alias gca="git commit --amend"
alias gcane="git commit --amend --no-edit"
alias gcl="git clone"

alias gco="git checkout"
alias gcb="git checkout -b"
alias gsw="git switch"
alias gswc="git switch -c"
alias gb="git branch"
alias gba="git branch -a"
alias gbd="git branch -d"

alias gf="git fetch"
alias gfa="git fetch --all --prune"
alias gl="git pull"
alias gp="git push"
alias gpf="git push --force-with-lease"

alias glog="git log --oneline --decorate --graph"
alias gloga="git log --oneline --decorate --graph --all"

alias gstash="git stash"
alias gstp="git stash pop"
alias gstl="git stash list"
alias gstd="git stash drop"

alias grb="git rebase"
alias grbi="git rebase -i"
alias grba="git rebase --abort"
alias grbc="git rebase --continue"
alias gm="git merge"

alias grh="git reset HEAD"
alias grhh="git reset --hard HEAD"
alias grs="git restore"
alias grss="git restore --staged"

alias gcp="git cherry-pick"

# --------- delta (git diff improvements) ---------
alias diff="delta"
alias gd="git diff | delta"
alias gds="git diff --staged | delta"

# --------- curl ---------
alias curl='curl --progress-bar'

# --------- fzf integrations ---------
alias hist="atuin search -i"
alias fbat="fzf --preview 'bat --style=numbers --color=always --line-range :500 {}'"

# --------- misc quality of life ---------
alias cls="printf '\033c'"                                     # Clear but keep scrollback
alias reload="source ~/.zshrc && echo 'Zsh reloaded'"         # Quick reload
alias edaliases="nvim ~/.aliases"                              # Edit aliases
alias edexports="nvim ~/.exports"                              # Edit exports
alias edfunctions="nvim ~/.functions"                          # Edit functions

# --------- tldr (tealdeer) ---------
alias td='tldr'

# --------- fd ---------
alias fd-find='fd'

# --------- trash ------
#alias rm='trash'

# --------- modern system monitors ---------
alias top='btop'
alias df='duf'
alias du='dust'
alias ps='procs'
alias battery='batt'
alias gpu='asitop'
alias mtop='mactop'
alias ncdu='ncdu'
alias gdu='gdu-go'
alias tree='tree'

# --------- dotfiles / homebrew ---------
# Regenerate the tracked Brewfile from the current machine.
# The PATH prefix puts real npm ahead of aube's shim; without it
# Homebrew's npm extension fails to parse `npm list` and aborts.
brewdump() {
  local bf="$HOME/Developer/macos-dot-files/homebrew/Brewfile"
  PATH="/opt/homebrew/bin:$PATH" brew bundle dump --force --file="$bf" || return
  # mas reports TestFlight (and delisted) apps as id: 0. They are not App Store
  # purchases, so `mas install 0` always fails -- drop them instead of tracking
  # entries that can only break `brew bundle install` on a fresh machine.
  local dropped
  dropped=$(grep ', id: 0$' "$bf")
  if [ -n "$dropped" ]; then
    sed -i '' '/^mas .*, id: 0$/d' "$bf"
    echo "dropped untracked TestFlight/unresolvable apps:"
    echo "$dropped" | sed 's/^/  /'
  fi
  echo "Brewfile updated: $bf"
}
