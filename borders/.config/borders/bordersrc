#!/usr/bin/env bash
#
# JankyBorders — draws a ring around the focused window so you can tell at a
# glance which tile has focus.
#
# Runs as a brew service (`brew services start borders`), which invokes the
# binary with no arguments -- that is what makes it exec this file; the call at
# the bottom, with arguments, then starts the real process. Invoking it with
# arguments while an instance is running updates that instance in place, so
# editing this file and running it re-applies without a service restart.
#
# Absolute path because launchd gives this a minimal PATH.
#
# Colours: Catppuccin Macchiato, format 0xAARRGGBB.

BORDERS="/opt/homebrew/bin/borders"
[ -x "$BORDERS" ] || BORDERS="$(command -v borders)" || exit 1

options=(
    style=round
    width=6.0
    hidpi=off
    active_color=0xffc6a0f6      # mauve
    inactive_color=0xff363a4f    # surface0

    # Apps whose own chrome a rectangular ring fights rather than clarifies:
    # the Simulator draws a device bezel and sizes itself to the device aspect
    # ratio, Droppy is a floating shelf panel.
    # Names here are application names, not bundle IDs.
    blacklist="Simulator,Droppy"
)

"$BORDERS" "${options[@]}"
