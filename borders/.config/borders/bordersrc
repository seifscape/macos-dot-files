#!/usr/bin/env bash
#
# JankyBorders — draws a ring around the focused window so you can tell at a
# glance which tile has focus.
#
# AeroSpace starts this via `exec-and-forget /opt/homebrew/bin/borders` in
# ~/.aerospace.toml. Run with no arguments, the borders binary execs this file;
# the call at the bottom (with arguments) then starts the real process.
#
# Absolute path because AeroSpace's exec environment has a minimal PATH.
#
# Colours: Catppuccin Macchiato, format 0xAARRGGBB.

BORDERS="/opt/homebrew/bin/borders"
[ -x "$BORDERS" ] || BORDERS="$(command -v borders)" || exit 1

options=(
    style=round
    width=6.0
    hidpi=off
    active_color=0xffc6a0f6      # mauve
    inactive_color=0xff363a4f    # surface0

    # The Simulator draws its own device bezel and resizes itself to the device
    # aspect ratio; a rectangular ring around it just fights the chrome.
    # Names here are application names, not bundle IDs.
    blacklist="Simulator"
)

"$BORDERS" "${options[@]}"
