theme = Catppuccin Frappe
#theme = hyper
#macos-icon = blueprint
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/catppuccin-macchiato.icns

# Hide macOS native title bar for a more immersive experience
window-theme = ghostty
window-title-font-family="MonoLisa Variable"
# Default Shell
command = /bin/zsh -l

#background-image = ~/.config/ghostty/block-wave-moon.png
#background-image-opacity = 0.2
#background-image-fit = cover
background-blur = macos-glass-regular
background-opacity = 0.95
# Apply the opacity to cells with an explicit background too, so the tmux bar
# blends with the blur and starfield instead of showing as a solid strip.
background-opacity-cells = true
background-blur-radius = 20

# Starfield shader from omerxx/dotfiles
custom-shader = ~/.config/ghostty/shaders/space.glsl

font-family = "JetBrainsMonoNL Nerd Font"
font-family-bold = "JetBrainsMonoNL Nerd Font Bold"
font-family-italic = "JetBrainsMonoNL Nerd Font Italic"
font-family-bold-italic = "JetBrainsMonoNL Nerd Font Bold Italic"

font-size = 16
font-thicken = false
# adjust-cell-height = 40%
adjust-box-thickness = -1

window-decoration = auto
window-padding-x = 10
window-padding-y = 10
# Fill the padding with the editor background (Neovim) and centre the grid
window-padding-color = extend
window-padding-balance = true
window-width = 226
window-height = 64
window-position-x = 128
window-position-y = 73
#macos-titlebar-style = hidden

minimum-contrast = 1.1

cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true

# Pi 5 Fix
copy-on-select = false
shell-integration = detect
shell-integration-features = ssh-terminfo,ssh-env

clipboard-paste-protection = true

# Command Finish Notifications
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 15s

# --- Keybindings

# Claude
keybind = shift+enter=text:\n

